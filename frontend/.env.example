# Base URL of the Destrava backend (uvicorn backend.main:app).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Project planner (POST /projetos): the one backend route available today. On by default.
# Set to "false" to plan projects with the in-browser mock instead.
NEXT_PUBLIC_USE_PLANNER_API=true

# Auth, chat (/chat/stream) and calendar (/calendar/events) have no backend route yet.
# Keep "true" so they run on the in-browser mocks.
NEXT_PUBLIC_USE_MOCKS=true
