# Base URL of the Destrava backend (uvicorn backend.main:app).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Project planner (POST /projetos). On by default.
# Set to "false" to plan projects with the in-browser mock instead.
NEXT_PUBLIC_USE_PLANNER_API=true

# Chat (POST /chat/stream): the backend Supervisor, running on Ollama. On by default.
# Set to "false" to chat with the in-browser mock instead.
NEXT_PUBLIC_USE_CHAT_API=true

# Auth (/auth/google/session) and calendar (/calendar/events) use the backend by default.
# Set to "true" to run them on the in-browser mocks (no Google account needed).
NEXT_PUBLIC_USE_MOCKS=false
